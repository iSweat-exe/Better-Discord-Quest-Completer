{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Quest Completer",
  "version": "2.0.0",
  "identifier": "dev.questcompleter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Discord Quest Completer",
        "width": 1100,
        "height": 720,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#15151c"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: https://cdn.discordapp.com",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: https://cdn.discordapp.com",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Validez vos Quêtes Discord sans installer les jeux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNDUxMjk3QkUyMTE1NEIKUldSTEZTRytseEpGVHpYTEVZb3BlMnJGc2U2M3NuZ0IxeHlkT2xycmh6cUlOR2NmVUEwd2hhUE4K",
      "endpoints": [
        "https://github.com/iSweat-exe/Better-Discord-Quest-Completer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
